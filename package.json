{
  "name": "@haex-space/vault-sdk",
  "version": "3.2.7",
  "description": "SDK for building Haex Vault extensions",
  "repository": {
    "type": "git",
    "url": "https://github.com/haex-space/vault-sdk.git"
  },
  "homepage": "https://github.com/haex-space/vault-sdk#readme",
  "bugs": {
    "url": "https://github.com/haex-space/vault-sdk/issues"
  },
  "keywords": [
    "tauri",
    "sdk",
    "extension",
    "haex"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.mjs",
      "require": "./dist/node.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.mjs",
      "require": "./dist/vue.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.mjs",
      "require": "./dist/svelte.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.mjs",
      "require": "./dist/nuxt.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.js"
    }
  },
  "bin": {
    "haex": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/node.ts src/cli/index.ts src/vue.ts src/react.ts src/svelte.ts src/nuxt.ts src/vite.ts src/runtime/nuxt.plugin.client.ts --dts --format cjs,esm --external @nuxt/kit --external nuxt --external vite --external vue --external react --external svelte --external svelte/store && cp src/runtime/nuxt.types.d.ts dist/runtime/nuxt.types.d.ts",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "node scripts/release.js"
  },
  "author": "haex",
  "license": "ISC",
  "packageManager": "pnpm@10.15.1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nuxt/kit": "^4.3.1",
    "@nuxt/schema": "^4.3.1",
    "@types/archiver": "^7.0.0",
    "@types/node": "^25.2.2",
    "@types/react": "^19.2.13",
    "eslint": "^10.0.0",
    "happy-dom": "^20.9.0",
    "nuxt": "^4.3.1",
    "react": "^19.2.4",
    "svelte": "^5.50.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vue": "^3.5.27"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3.0.0 || ^4.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "svelte": "^4.0.0 || ^5.0.0",
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "commander": "^14.0.3",
    "drizzle-orm": "^0.45.1",
    "jszip": "^3.10.1"
  }
}
